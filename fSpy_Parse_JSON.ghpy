# fSpy Parse JSON - Grasshopper Python component
# Input: path to fSpy "Camera parameters as JSON" file, or JSON string
# Outputs: camera position, target, up, FOV, image size, principal point
# Use with fSpy_Apply_To_View.ghpy to set the Rhino viewport.
# See https://fspy.io/

import json
import math
from Rhino.Geometry import Point3d, Vector3d

def parse_fspy_json(json_input):
    """Parse fSpy camera parameters from file path or JSON string."""
    r = {"camera_location": None, "camera_direction": None, "camera_up": None,
         "camera_target": None, "horizontal_fov_rad": None, "vertical_fov_rad": None,
         "image_width": None, "image_height": None, "principal_point": None,
         "target_distance": 100.0, "error": None}
    try:
        if json_input is None:
            r["error"] = "Conecta un Panel con la ruta al archivo .json (ej: C:\\Carpeta\\camara.json)"
            return r
        s = str(json_input).strip()
        if not s or s.lower() == "none":
            r["error"] = "Conecta un Panel con la ruta al archivo .json (ej: C:\\Carpeta\\camara.json)"
            return r
        data = json.load(open(s, "r")) if not s.startswith("{") else json.loads(s)
        rows = data.get("cameraTransform", {}).get("rows")
        if not rows or len(rows) < 4:
            r["error"] = "Invalid cameraTransform"
            return r
        tx, ty, tz = float(rows[0][3]), float(rows[1][3]), float(rows[2][3])
        r["camera_location"] = Point3d(tx, ty, tz)
        zx, zy, zz = float(rows[0][2]), float(rows[1][2]), float(rows[2][2])
        look = Vector3d(-zx, -zy, -zz)
        if look.Length > 1e-10:
            look.Unitize()
        r["camera_direction"] = look
        ux, uy, uz = float(rows[0][1]), float(rows[1][1]), float(rows[2][1])
        up = Vector3d(ux, uy, uz)
        if up.Length > 1e-10:
            up.Unitize()
        r["camera_up"] = up
        td = 100.0
        try:
            td = max(0.1, float(data.get("targetDistance", 100)))
        except (TypeError, ValueError):
            pass
        r["target_distance"] = td
        r["camera_target"] = Point3d(tx + look.X*td, ty + look.Y*td, tz + look.Z*td)
        r["horizontal_fov_rad"] = float(data.get("horizontalFieldOfView", 0))
        r["vertical_fov_rad"] = float(data.get("verticalFieldOfView", 0))
        r["image_width"] = int(data.get("imageWidth", 0))
        r["image_height"] = int(data.get("imageHeight", 0))
        r["principal_point"] = data.get("principalPoint", {"x": 0, "y": 0})
    except Exception as e:
        r["error"] = str(e)
    return r

# --- Input: rename the first input to "json_path_or_string" (path to .json file or JSON string) ---
try:
    json_path_or_string
except NameError:
    json_path_or_string = None

data = parse_fspy_json(json_path_or_string)

err = data.get("error")

# Outputs (add these in the component: CameraLocation, CameraTarget, CameraUp, FOV_h_deg, FOV_v_deg, ImageW, ImageH, PrincipalPoint, Error)
CameraLocation = data["camera_location"]
CameraTarget = data["camera_target"]
CameraUp = data["camera_up"]
FOV_h_deg = math.degrees(data["horizontal_fov_rad"]) if data.get("horizontal_fov_rad") else None
FOV_v_deg = math.degrees(data["vertical_fov_rad"]) if data.get("vertical_fov_rad") else None
ImageW = data["image_width"]
ImageH = data["image_height"]
PrincipalPoint = data["principal_point"]
Error = err

if err:
    print("fSpy Parse: " + err)
